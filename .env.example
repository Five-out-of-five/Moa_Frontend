# MOA Frontend 환경변수 예시
# 복사해서 `.env.local` 만들어 쓰고, 실제 값은 절대 커밋하지 않는다.

# ===== 목 모드 토글 =====
# "false" 이면 실서버 호출, 그 외(기본) 이면 목 데이터.
# 개발 중엔 켜 두고(기본), BE 가 붙으면 .env.local 에 false 로 지정.
NEXT_PUBLIC_USE_MOCK=true

# ===== API =====
# BE 서버 주소 (서버 사이드에서만 쓴다, httpOnly 쿠키 전제)
BACKEND_BASE_URL=http://localhost:8080
# BFF 요청에 붙일 공용 타임아웃 (ms)
API_DEFAULT_TIMEOUT_MS=10000

# ===== WebSocket / SSE =====
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_SSE_URL=ws://localhost:8080/sse

# ===== 인증 토큰 (서버 전용) =====
# JWT 서명 비밀키 등은 서버에서만 접근. NEXT_PUBLIC_ 접두사 금지.
JWT_SECRET=change-me-in-production

# ===== 관측 (옵션) =====
LOKI_PUSH_URL=
LOKI_BASIC_AUTH=
