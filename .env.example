# MOA Frontend 환경변수 예시
# 복사해서 `.env.local` 만들어 쓰고, 실제 값은 절대 커밋하지 않는다.

# ===== 목 모드 토글 =====
# "false" 이면 실서버 호출, 그 외(기본) 이면 목 데이터.
# 개발 중엔 켜 두고(기본), BE 가 붙으면 .env.local 에 false 로 지정.
NEXT_PUBLIC_USE_MOCK=

# 인증은 다른 도메인 목 설정과 별도로 전환한다. 미설정 시 목 인증.
AUTH_USE_MOCK=
# BE OAuth 시작 주소. 실서버 인증 사용 시 제공자별로 지정한다.
# 미설정 시 운영은 현재 Origin, 로컬은 BACKEND_BASE_URL의 /oauth2/authorization/{provider}를 사용한다.
AUTH_OAUTH_BASE_URL=
AUTH_GOOGLE_LOGIN_URL=
AUTH_KAKAO_LOGIN_URL=
AUTH_NAVER_LOGIN_URL=
# BE가 허용하는 프론트 Origin
AUTH_FRONTEND_ORIGIN=

# ===== API =====
# BE 서버 주소 (서버 사이드에서만 쓴다, httpOnly 쿠키 전제)
BACKEND_BASE_URL=
# BFF 요청에 붙일 공용 타임아웃 (ms)
API_DEFAULT_TIMEOUT_MS=

# ===== WebSocket / SSE =====
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_SSE_URL=

# ===== 인증 토큰 (서버 전용) =====
# JWT 서명 비밀키 등은 서버에서만 접근. NEXT_PUBLIC_ 접두사 금지.
JWT_SECRET=
# 실서버 로그인에서 사용하는 httpOnly 액세스 토큰 쿠키 이름 (기본 accessToken)
AUTH_ACCESS_TOKEN_COOKIE_NAME=

# ===== 관측 (옵션) =====
LOKI_PUSH_URL=
LOKI_BASIC_AUTH=
