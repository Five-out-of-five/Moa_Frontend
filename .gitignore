# MOA Frontend .gitignore
# 민감 파일 유출 방지가 1순위. 이 파일을 가장 먼저 커밋한 뒤 나머지를 올린다.

# ===== 의존성 =====
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===== Next.js 빌드/캐시 =====
/.next/
/out/

# ===== 테스트/빌드 산출물 =====
/coverage
/build
/dist

# ===== 환경변수 (민감) =====
# .env 는 어떤 변형이든 커밋 금지. 예시만 .env.example 로 공유.
.env
.env.*
!.env.example

# ===== 개인 인증서/키 =====
*.pem
*.key
*.crt
*.p12
*.pfx

# ===== 로그 =====
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ===== OS/에디터 =====
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.example.json
!.vscode/extensions.json

# ===== Vercel / 배포 =====
.vercel

# ===== TypeScript 캐시 =====
*.tsbuildinfo
next-env.d.ts

# ===== 로컬 개발 서버·에이전트 설정 (개인 환경) =====
.claude/launch.json
.claude/settings.local.json

# ===== Playwright/테스트 산출물 =====
/playwright-report/
/test-results/
/.playwright-cache/

# ===== 번들 분석 =====
/.analyze/
bundle-stats.json
